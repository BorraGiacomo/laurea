\frametitle{Modello della rete}

\begin{columns}[c]

    \column{0.5\textwidth}

    \begin{itemize}
        \item Per calcolare Equilibrio di Nash cerchiamo il punto fisso di Brouwer di una specifica funzione
        \item Applicazione iterata della funzione al risultato ottenuto da essa
        \item Possibile analisi di paradossi di Braess, anche con 2 popolazioni
    \end{itemize}

    \column{0.5\textwidth}

    \begin{lstlisting}[style=myStile]
def f_hat(...):
    composition = phi(
        T_hat(...)
    )

    return self.normalize(
        theta_hat
        - self.lmbda * (
            composition
            - (theta_hat.T @ composition)[0]
              * self.one_n_hat
        )
    )
\end{lstlisting}

\end{columns}

